# Copie este arquivo para .env.local e substitua pelos dados do aplicativo Web.
# Firebase Console > Configurações do projeto > Seus aplicativos > SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Relatórios modernos (serviços separados do Hosting estático).
# Ativar IA somente após configurar credencial, modelo e aprovação técnica no backend.
NEXT_PUBLIC_REPORT_AI_ENABLED=false
NEXT_PUBLIC_REPORTS_REGION=southamerica-east1
NEXT_PUBLIC_REPORT_PDF_URL=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
