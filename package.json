{
  "name": "conferencia-laboratorial-mvp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next dev",
    "test": "node --test tests/*.test.mjs",
    "test:reports:rules": "node tests/run-report-rules.mjs",
    "dev:reports:demo": "node tests/run-report-demo.mjs",
    "seed:reports:demo": "node tests/seed-report-demo.mjs",
    "typecheck": "tsc --noEmit",
    "firebase:deploy": "pnpm build && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next",
    "test:reports:backend": "node --test functions/tests/*.test.mjs",
    "build:reports:backend": "node scripts/build-report-backend.mjs functions && node scripts/build-report-backend.mjs pdf",
    "verify:reports:v4": "node tests/verify-report-v4-artifacts.mjs",
    "test:reports:v4:backend": "node tests/run-report-v4-backend.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "docx": "^9.8.1",
    "firebase": "12.16.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "firebase-tools": "^15.24.0",
    "playwright": "^1.64.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
